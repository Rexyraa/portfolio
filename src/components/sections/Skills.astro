---
import { messages } from '../../i18n';
import { tools } from '../../data/tools';
import AssetMark from '../ui/AssetMark.astro';
import BackgroundAccent from '../ui/BackgroundAccent.astro';
import type { Locale } from '../../types/portfolio';
const { lang } = Astro.props as { lang: Locale };
const t = messages[lang];
---
<section id="skills" class="section tinted"><BackgroundAccent /><div class="container"><p class="section-label">02 / {t.nav.skills}</p><h2>{t.skillsTitle}</h2><div class="card-grid skill-groups">{[[t.technical,t.technicalBody,'01'],[t.collaboration,t.collaborationBody,'02']].map(([title,body,index]) => <article class="card skill-card"><span class="card-number">{index}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
	<div class="tools-section"><h3>{t.toolsTitle}</h3><div class="tools-grid">{tools.map(tool => <article class="card tool-card" data-tool={tool.id}><AssetMark file={tool.logo} monogram={tool.monogram} alt={`${t.logo}: ${tool.name}`} tool /><h4>{tool.name}</h4><p>{tool.function[lang]}</p></article>)}</div></div>
</div></section>
<style>
	.skill-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.skill-card { min-height: 0; }
	.tools-section { margin-top: 40px; }
	.tools-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; margin-top: 22px; }
	.tool-card { padding: 24px 12px; text-align: center; }
	.tool-card h4 { font-size: .9rem; letter-spacing: -.02em; margin: 18px 0 8px; }
	.tool-card p { font-size: .78rem; margin: 0; }
	@media (max-width: 1100px) { .tools-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
	@media (max-width: 767px) { .skill-groups { grid-template-columns: 1fr; } .tools-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>