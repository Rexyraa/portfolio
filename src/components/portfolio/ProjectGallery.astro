---
import { imageAsset, originalImageAsset } from '../../utils/assets';
import { messages } from '../../i18n';
import type { Locale, Project } from '../../types/portfolio';
interface Props { lang: Locale; images: NonNullable<Project['gallery']>; }
const { lang, images } = Astro.props;
const gallery = [...images].sort((a,b) => a.order - b.order);
const t = messages[lang];
---
<div data-gallery>
  {!gallery.length && <p class="empty-state">{t.previewPending}</p>}
  {gallery.map((image, index) => <figure data-gallery-slide>
    <a href={imageAsset(image.path)} data-dialog={`preview-${index}`} aria-label={`${t.enlarge}: ${image.alt[lang]}`}><img class="gallery-main" src={imageAsset(image.path)} alt={image.alt[lang]} /></a>
    {image.caption && <figcaption>{image.caption[lang]}</figcaption>}
    <div class="gallery-actions"><a href={originalImageAsset(image.path)} data-dialog={`preview-${index}`}>{t.enlarge}</a><a href={originalImageAsset(image.path)}>{t.original}</a></div>
    <dialog id={`preview-${index}`} class="image-dialog" aria-label={image.alt[lang]}><form method="dialog"><button class="button secondary" autofocus>{t.close}</button></form><img loading="lazy" src={originalImageAsset(image.path)} alt={image.alt[lang]} /><a href={originalImageAsset(image.path)}>{t.original}</a></dialog>
  </figure>)}
  {gallery.length > 1 && <div class="gallery-navigation" hidden>
    <button class="icon-button" data-gallery-prev aria-label={t.previousImage}>←</button>
    <div class="gallery-dots">{gallery.map((image, index) => <button data-gallery-select={index} aria-label={`${index + 1}: ${image.alt[lang]}`} aria-pressed={index === 0 ? 'true' : 'false'}><span></span></button>)}</div>
    <button class="icon-button" data-gallery-next aria-label={t.nextImage}>→</button>
    <span class="sr-only" data-gallery-position aria-live="polite"></span>
  </div>}
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(gallery => {
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
    const navigation = gallery.querySelector<HTMLElement>('.gallery-navigation');
    if (!navigation) return;
    let current = 0;
    const select = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => { slide.hidden = i !== current; });
        gallery.querySelectorAll('[data-gallery-select]').forEach((button, i) => button.setAttribute('aria-pressed', String(i === current)));
        gallery.querySelector('[data-gallery-position]')!.textContent = `${current + 1} / ${slides.length}`;
    };
    navigation.hidden = false;
    gallery.querySelector('[data-gallery-prev]')!.addEventListener('click', () => select(current - 1));
    gallery.querySelector('[data-gallery-next]')!.addEventListener('click', () => select(current + 1));
    gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-select]').forEach(button => button.addEventListener('click', () => select(Number(button.dataset.gallerySelect))));
    let touchStart: { x: number; y: number } | null = null;
    gallery.addEventListener('touchstart', event => {
      const touch = event.touches[0];
      touchStart = event.touches.length === 1 ? { x: touch.clientX, y: touch.clientY } : null;
    }, { passive: true });
    gallery.addEventListener('touchend', event => {
      if (!touchStart || !event.changedTouches.length || (event.target as Element).closest('dialog, .gallery-navigation')) return;
      const dx = event.changedTouches[0].clientX - touchStart.x;
      const dy = event.changedTouches[0].clientY - touchStart.y;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) select(current + (dx < 0 ? 1 : -1));
      touchStart = null;
    }, { passive: true });
    select(0);
});
</script>